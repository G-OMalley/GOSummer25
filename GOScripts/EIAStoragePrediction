# --- 796 INTEGRATION START: Main function with regional toggles and enhanced data loading/processing ---
def main():
    print("Loading...")

    # Define regional feature toggles and model scaling factors.
    # This dictionary is the core of the hybrid approach, allowing
    # specific features (weather, criterion, henry, platts) to be
    # turned on/off per region, and a model_scale to be applied.
    region_toggles = {
        "East Region":          {"use_weather": True, "use_criterion": True, "use_henry": False, "use_platts": True,  "model_scale": 1.0},
        # --- EDITED FOR MIDWEST REGION: To use 605 logic exactly ---
        # Original 605 used LNG, Midwest-specific Pipe Imports (part of criterion),
        # and general positioning/price/Platts (part of platts toggle).
        # It did not use Henry Flow and had no explicit model scale.
        "Midwest Region":       {"use_weather": True, "use_criterion": True, "use_henry": False, "use_platts": True, "model_scale": 1.0},
        # --- END EDIT FOR MIDWEST REGION ---
        "South Central Region": {"use_weather": True, "use_criterion": True, "use_henry": True,  "use_platts": False, "model_scale": 0.70},
        "Mountain Region":      {"use_weather": True, "use_criterion": False,"use_henry": True,  "use_platts": False, "model_scale": 1.0},
        "Pacific Region":       {"use_weather": True, "use_criterion": True, "use_henry": False, "use_platts": True,  "model_scale": 1.0},
        "Lower 48 States":      {"use_weather": True, "use_criterion": True, "use_henry": False, "use_platts": True,  "model_scale": 1.0},
    }
    # Flag to determine if Lower 48 forecast should be the sum of its parts
    USE_SUM_OF_PARTS_FOR_L48 = True

    # Load core data files
    chg_full, tot_full, fdy_full, wth_full = core_data()
    if any(df is None for df in [chg_full, tot_full, fdy_full, wth_full]):
        sys.exit(f"❌ One or more core CSV files are missing. Please check the INFO directory.")

    # Process weekly weather data
    wwk_full = weekly_weather(wth_full)
    # Load LNG data
    lng_full = lng_data()
    # Load positioning data
    pos_full = positioning_data()
    # Load and process price features
    price_full = make_price_features()

    # Load Henry Flow data (new in 796 for specific regions)
    henry_flow_full = get_csv("CriterionHenryFlows.csv", ["Date"])
    if henry_flow_full is None:
        print("Warning: CriterionHenryFlows.csv not found. Henry Flow features will not be used.")

    # Load and clean Platts CONUS Fundamentals (new in 796 for specific regions)
    platts_conus_path = DATA_DIR / "PlattsCONUSFundamentalsHIST.csv"
    platts_conus_full = None
    try:
        platts_conus_raw = pd.read_csv(platts_conus_path, parse_dates=["GasDay"])
        platts_conus_raw = platts_conus_raw.dropna(subset=["GasDay"])
        platts_conus_full = platts_conus_raw.rename(columns={"GasDay": "Date"}).set_index("Date").sort_index()
    except Exception:
        pass # platts_conus_full remains None

    selected_platts_features = [
        "DryGasProduction", "MexExp", "LNGExports",
        "PowerBurn", "ResComDemand", "NetImpliedFlow"
    ]

    weekly_platts_full = None
    if platts_conus_full is not None and not platts_conus_full.empty:
        existing_platts_features = [f for f in selected_platts_features if f in platts_conus_full.columns]
        if existing_platts_features:
            weekly_platts_full = platts_conus_full[existing_platts_features].resample("W-FRI").mean().dropna()

    # Build weekly salt / non-salt Criterion series
    locs = get_csv("locs_list.csv", [])

    weekly_salt_crit_df_full = None
    weekly_nsalt_crit_df_full = None

    required_locs_cols = ['storage_name', 'state_name', 'storage_type']
    if locs is not None and all(col in locs.columns for col in required_locs_cols):
        crit_full = get_csv("CriterionStorageChange.csv", ["eff_gas_day"])
        if crit_full is not None:
            crit_full = (crit_full.merge(locs[required_locs_cols],
                                            on='storage_name', how='left'))

            # --- 796 INTEGRATION: Apply FACILITY_TO_REGION_MAP first, then STATE_TO_REGION ---
            # This provides more accurate regional mapping for Criterion data.
            crit_full['Region'] = crit_full['storage_name'].map(FACILITY_TO_REGION_MAP)
            crit_full['Region'] = crit_full['Region'].fillna(crit_full['state_name'].map(STATE_TO_REGION))
            # --- 796 INTEGRATION END ---

            crit_full = crit_full.dropna(subset=['Region', 'storage_type'])
            crit_full.set_index('eff_gas_day', inplace=True)

            weekly_salt_crit_df_full = (crit_full[crit_full['storage_type'].str.contains('salt',case=False)]
                                    .groupby([pd.Grouper(freq='W-FRI'), 'Region'])['daily_storage_change']
                                    .sum()
                                    .unstack('Region')
                                    .add_prefix('Salt_'))
            weekly_nsalt_crit_df_full = (crit_full[~crit_full['storage_type'].str.contains('salt',case=False)]
                                     .groupby([pd.Grouper(freq='W-FRI'), 'Region'])['daily_storage_change']
                                     .sum()
                                     .unstack('Region')
                                     .add_prefix('NSalt_'))

    # --- 796 INTEGRATION: Calculate historical Sum-of-Parts for L48 features ---
    # This logic is updated to correctly sum regional changes, including the
    # combined South Central target if available.
    l48_sum_cols_for_sop = [f"{r} Storage Change (Bcf)" for r in REGIONS if r not in ["Lower 48 States", "South Central Region"]]
    if "Salt Region SC Storage Change (Bcf)" in chg_full.columns and "Nonsalt Region SC Storage Change (Bcf)" in chg_full.columns:
        chg_full["South Central Region Storage Change (Bcf)_Combined"] = chg_full["Salt Region SC Storage Change (Bcf)"] + chg_full["Nonsalt Region SC Storage Change (Bcf)"]
        l48_sum_cols_for_sop.append("South Central Region Storage Change (Bcf)_Combined")
    elif "South Central Region Storage Change (Bcf)" in chg_full.columns:
        l48_sum_cols_for_sop.append("South Central Region Storage Change (Bcf)")

    existing_l48_sum_cols = [col for col in l48_sum_cols_for_sop if col in chg_full.columns]

    if existing_l48_sum_cols:
        chg_full["HistoricalSumOfParts"] = chg_full[existing_l48_sum_cols].sum(axis=1)
    else:
        chg_full["HistoricalSumOfParts"] = np.nan
    # --- 796 INTEGRATION END ---

    latest_eia_date = chg_full.index.max()
    current_forecast_date = latest_eia_date + timedelta(days=7)

    output_rows = []

    # Iterate through regions to generate forecasts
    for r in REGIONS:
        # Get region-specific toggles from the dictionary
        region_config = region_toggles.get(r, {})
        use_enhanced_weather = region_config.get("use_weather", False)
        use_criterion = region_config.get("use_criterion", False)
        use_henry_flow = region_config.get("use_henry", False)
        use_platts = region_config.get("use_platts", False)
        model_scale = region_config.get("model_scale", 1.0)

        print(f"\n--- Region: {r} ---")
        print(f"   Toggles applied: Weather={use_enhanced_weather}, Criterion={use_criterion}, Henry={use_henry_flow}, Platts={use_platts}, Scale={model_scale}")
        print("--------------------")

        # Call the ml function with all parameters and request full data for backtesting
        current_fcst, mae_4wk, mae_12wk, current_preds_history, current_actuals_history = ml(
            r, latest_eia_date, chg_full, tot_full, fdy_full, wwk_full, lng_full,
            weekly_salt_crit_df_full, weekly_nsalt_crit_df_full, pos_full, price_full,
            weekly_platts_full, henry_flow_full, use_henry_flow, use_enhanced_weather,
            use_criterion, use_platts, REGIONS_USE_POS, REGIONS_USE_PRICE, return_full_data=True
        )

        # Apply model scale to the forecast
        if not np.isnan(current_fcst):
            original_fcst = current_fcst
            current_fcst *= model_scale
            print(f"[{r}] Raw Forecast: {original_fcst:.2f} Bcf, Scaled Forecast: {current_fcst:.2f} Bcf (Scale: {model_scale:.2f})")

        # Display 4-week backtest (prediction vs actual) - NEW ADDITION
        if current_preds_history is not None and current_actuals_history is not None:
            print(f"\n[{r}] 4-Week Backtest:")

            # Ensure we have enough data for the last 4 weeks
            num_weeks_to_show = min(4, len(current_actuals_history))
            if num_weeks_to_show > 0:
                # Build DataFrame
                bt_df = pd.DataFrame({
                    "Date": current_actuals_history.index[-num_weeks_to_show:],
                    "Region": r,
                    "Predicted": (current_preds_history[-num_weeks_to_show:] * model_scale).round(2),
                    "Actual": current_actuals_history.iloc[-num_weeks_to_show:].round(2)
                })
                bt_df["Error"] = (bt_df["Predicted"] - bt_df["Actual"]).round(2)

                # Show table
                print(tabulate(bt_df, headers="keys", tablefmt="github", showindex=False))
            else:
                print(f"Not enough data to show 4-week backtest for {r}.")

        # --- 796 INTEGRATION: Retrieve previous week's actual and forecast ---
        prev_wk_actual = _get_regional_actual(chg_full, latest_eia_date, r)
        prev_wk_fcst = np.nan
        if current_preds_history is not None and len(current_preds_history) >= 2:
            # We want the prediction for the week whose actual is latest_eia_date
            # The last prediction in current_preds_history is for current_forecast_date
            # So the one before that is for latest_eia_date
            prev_wk_fcst_raw = current_preds_history[-1] # This would be the prediction for current_forecast_date
            if len(current_preds_history) > 1:
                # The second to last prediction is for latest_eia_date
                prev_wk_fcst_raw = current_preds_history[-2] 
            else: # If there's only one prediction, it's for current_forecast_date, so prev_wk_fcst is NaN
                prev_wk_fcst_raw = np.nan

            if not np.isnan(prev_wk_fcst_raw):
                prev_wk_fcst = prev_wk_fcst_raw * model_scale # Apply scale to previous week's forecast as well
        # --- 796 INTEGRATION END ---

        # Append results to output_rows
        output_rows.append({
            "Region": r,
            "Forecast (Bcf)": round(current_fcst, 2),
            "Prev-wk Fcst": round(prev_wk_fcst, 2),
            "Prev-wk Actual": round(prev_wk_actual, 2),
            "4-wk MedAE": round(mae_4wk, 2),
            "12-wk MedAE": round(mae_12wk, 2),
            "Forecast Date": current_forecast_date.strftime("%Y-%m-%d")
        })

    # --- 796 INTEGRATION: Override Lower 48 forecast with Sum of Parts if enabled ---
    if USE_SUM_OF_PARTS_FOR_L48:
        sum_of_parts = sum(row["Forecast (Bcf)"] for row in output_rows if row["Region"] != "Lower 48 States")
        for row in output_rows:
            if row["Region"] == "Lower 48 States":
                print(f"\n[Override] Replacing Lower 48 forecast {row['Forecast (Bcf)']:.2f} Bcf → {sum_of_parts:.2f} Bcf (Sum of Parts)")
                row["Forecast (Bcf)"] = round(sum_of_parts, 2)
                break
    # --- 796 INTEGRATION END ---

    out = pd.DataFrame(output_rows)

    print("\nPreparing final output table and CSV.")
    # --- 796 INTEGRATION: Updated column order for the final output table ---
    col_order = [
        "Region",
        "Forecast (Bcf)",
        "Prev-wk Fcst",
        "Prev-wk Actual",
        "4-wk MedAE",
        "12-wk MedAE",
        "Forecast Date"
    ]
    # --- 796 INTEGRATION END ---

    for col in col_order:
        if col not in out.columns:
            out[col] = np.nan
    out = out[col_order]

    out_path = G_OUTPUT_DIR / "EIAStoragePred.csv"
    try:
        out.to_csv(out_path, index=False, float_format="%.2f")
    except PermissionError:
        print(f"\nERROR: Permission denied when writing to '{out_path}'.")
        print("Please ensure the file is not open in another program (e.g., Excel) and try again.")
        print(f"Attempting to save to a temporary file: '{out_path.parent / (out_path.stem + '_temp' + out_path.suffix)}'")
        out.to_csv(out_path.parent / (out_path.stem + '_temp' + out_path.suffix), index=False, float_format="%.2f")
    except Exception as e:
        print(f"\nERROR: An unexpected error occurred when writing the CSV: {e}")

    print("\n=== Weekly Storage-Change Forecast ===")
    print(tabulate(out, headers="keys", tablefmt="pipe", showindex=False))
    print(f"\nCSV written to: {out_path}\n")

if __name__ == "__main__":
    main()