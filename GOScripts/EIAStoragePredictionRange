# ────────── CSV helpers ──────────
def get_csv(name, dates):
    p = DATA_DIR / name
    if not p.exists():
        return None # Return None instead of exiting, allowing the script to continue without this data
    return pd.read_csv(p, parse_dates=dates)

def core_data():
    chg = get_csv("EIAchanges.csv", ["Period"]).set_index("Period")
    tot = get_csv("EIAtotals.csv", ["Period"]).set_index("Period")
    fdy = get_csv("Fundy.csv", ["Date"])
    wth = get_csv("WEATHER.csv", ["Date"])
    return chg, tot, fdy, wth

# ────────── LNG loader (fixed mapping) ──────────
def lng_data():
    lp = G_OUTPUT_DIR / "LNG_PIPE.csv"
    if lp.exists():
        return pd.read_csv(lp, parse_dates=["Date"])
    
    raw = DATA_DIR / "CriterionLNGHist.csv"
    if not raw.exists():
        return None 

    df = pd.read_csv(raw, parse_dates=["Date"])
    
    required_cols = ["Value", "state_name"]
    if not all(col in df.columns for col in required_cols):
        return None

    df = df.rename(columns={"Value": "LNG_Bcf", "state_name": "Region"})
    df["Region"] = df["Region"].map(STATE_TO_REGION)
    df.dropna(subset=['Region'], inplace=True)
    
    if df.empty:
        return None

    df["Pipe_Bcf"] = 0.0
    df.to_csv(lp, index=False)
    return df

# ────────── positioning data ──────────
def positioning_data():
    pos_file = (SCRIPT_DIR / "INFO" / "Natural_Gas_Data_positioning.csv")
    if not pos_file.exists():
        return None
    
    pos = pd.read_csv(pos_file, parse_dates=["Date"]).set_index("Date").sort_index()

    pos["Spread_MM_Prod"] = pos["Managed Money"] - pos["Producers"]
    pos["Spread_MM_Prod_z"] = (pos["Spread_MM_Prod"] - pos["Spread_MM_Prod"].rolling(52).mean()) / (
        pos["Spread_MM_Prod"].rolling(52).std()
    )
    pos["Spread_MM_Prod_z_lag1"] = pos["Spread_MM_Prod_z"].shift(1)

    pos = pos[["Spread_MM_Prod_z", "Spread_MM_Prod_z_lag1"]].resample("W-FRI").last().ffill().bfill()
    return pos

# ────────── PRICE helper ──────────
def make_price_features():
    p = DATA_DIR / "PRICES.csv"
    if not p.exists():
        return None

    temp_df = pd.read_csv(p)

    if "Henry" not in temp_df.columns:
        return None

    temp_df['Date_Parsed'] = pd.to_datetime(temp_df['Date'], errors='coerce')
    temp_df = temp_df.dropna(subset=['Date_Parsed'])
    if temp_df.empty:
        return None

    px = temp_df.loc[:, ["Date_Parsed", "Henry"]].rename(columns={"Date_Parsed": "Date"}).set_index("Date").sort_index()

    if not isinstance(px.index, pd.DatetimeIndex):
        raise TypeError(f"CRITICAL ERROR: Date column parsing failed for {p}.")

    wk = px.resample("W-FRI").mean()
    wk["dHenry"]  = wk["Henry"].diff()
    wk["Henry_z"] = (wk["Henry"] - wk["Henry"].rolling(12).mean()) / wk["Henry"].rolling(12).std()
    wk = wk.ffill().bfill()
    return wk

# ────────── Henry Flow Data Loader and Feature Engineering ──────────
def add_henry_features_to_df(df, base_index, henry_flow_data):
    """
    Adds Henry Hub flow features to the main feature DataFrame.
    Assumes henry_flow_data is already loaded with a 'date' or 'Date' column.
    """
    if henry_flow_data is None or henry_flow_data.empty:
        return df # Return original DataFrame if no Henry flow data

    # Create a temporary DataFrame for Henry flow features
    henry_temp_df = henry_flow_data.copy()
    
    # Ensure the date column is consistent before setting index
    if 'date' in henry_temp_df.columns:
        henry_temp_df.set_index("date", inplace=True)
    elif 'Date' in henry_temp_df.columns: # Assuming 'Date' is the actual column name
        henry_temp_df.set_index("Date", inplace=True)
    else:
        print("Warning: Henry Flow data does not have a 'date' or 'Date' column. Skipping Henry Flow features.")
        return df

    # --- START OF HENRY FLOW COLUMN RENAMING / CHECKING ---
    found_scheduled_col = None
    found_available_col = None

    for col in henry_temp_df.columns:
        if "scheduled" in col.lower() and "quantity" in col.lower():
            found_scheduled_col = col
        if "operationally" in col.lower() and "available" in col.lower():
            found_available_col = col
    
    if found_scheduled_col and found_available_col:
        henry_temp_df = henry_temp_df.rename(columns={
            found_scheduled_col: 'scheduled_quantity',
            found_available_col: 'operationally_available'
        })
    elif "scheduled_quantity" not in henry_temp_df.columns or "operationally_available" not in henry_temp_df.columns:
        print(f"Warning: Essential Henry Flow columns 'scheduled_quantity' and 'operationally_available' (or common variants) not found in CriterionHenryFlows.csv. Found columns: {henry_temp_df.columns.tolist()}. Skipping Henry Flow features.")
        return df # Exit if essential columns aren't found
    # --- END OF HENRY FLOW COLUMN RENAMING / CHECKING ---

    # Resample to weekly and calculate utilization
    grouped = henry_temp_df.groupby(pd.Grouper(freq='W-FRI'))[["scheduled_quantity", "operationally_available"]].sum()
    
    # Avoid division by zero
    grouped["utilization"] = grouped["scheduled_quantity"] / grouped["operationally_available"].replace(0, np.nan)
    
    grouped["util_lag1"] = grouped["utilization"].shift(1)
    grouped["util_roll3"] = grouped["utilization"].rolling(3).mean()
    grouped["util_diff"] = grouped["utilization"].diff(3)
    
    # Select desired features and reindex to match the base_index
    henry_features = grouped[["util_lag1", "util_roll3", "util_diff"]].reindex(base_index)
    
    # Join with the main DataFrame, dropping any rows that now have NaNs from the join
    df = df.join(henry_features, how='left')
    return df


# ────────── features ──────────
def weekly_weather(df):
    if df is None: return None
    frames = []
    unique_cities = df["City Title"].unique()
    for city in unique_cities:
        tmp = df[df["City Title"]==city].set_index("Date")
        wk  = tmp.resample("W-FRI").agg({"Avg Temp":"mean","CDD":"sum","HDD":"sum"})
        wk.columns = [f"{city}_{c.replace(' ', '')}" for c in wk.columns]
        frames.append(wk)
    return pd.concat(frames, axis=1)

def add_cal(df):
    wk = df.index.isocalendar().week.astype(int)
    df["SinWeek"] = np.sin(2*np.pi*wk/52)
    df["CosWeek"] = np.cos(2*np.pi*wk/52) # Corrected this back to the original form
    return df

def sar_delta(level):
    m = SARIMAX(level,
                order=SAR_ORDER,
                seasonal_order=SAR_SEAS,
                enforce_stationarity=False,
                enforce_invertibility=False)
    fit = m.fit(method="lbfgs", maxiter=30, disp=False)
    return fit.forecast()[0] - level.iloc[-1]

# ────────── ML block ──────────
def calculate_maes(df_feat, y_target, K_weeks=52):
    """
    Calculates 4-week and 12-week median absolute errors using a walk-forward approach.
    """
    min_history_needed = K_weeks # Need at least 52 weeks for initial training

    if len(df_feat) < min_history_needed + 12: # Ensure enough data for at least one 12-week test
        return np.inf # Not enough data for meaningful MAE calculation

    train_end_idx = len(df_feat) - 13 # Ensure at least 13 points for a test set
    if train_end_idx < K_weeks: # Not enough history for even one split
        return np.inf

    train_X = df_feat.iloc[:train_end_idx]
    test_X = df_feat.iloc[train_end_idx:] # Last 13 weeks (or whatever remains)
    
    train_y = y_target.loc[train_X.index]
    test_y = y_target.loc[test_X.index]

    if train_X.empty or test_X.empty or len(train_X) < 2 or len(test_X) < 2:
        return np.inf

    scaler = StandardScaler().fit(train_X)
    ridge = RidgeCV(alphas=[0.1,1,10]).fit(scaler.transform(train_X), train_y)
    
    etr = (LGBMRegressor(**GBM_PARAMS).fit(train_X, train_y)
            if USE_LIGHTGBM else
            ExtraTreesRegressor(n_estimators=300, random_state=42).fit(train_X, train_y)) 

    pred = 0.5 * ridge.predict(scaler.transform(test_X)) + 0.5 * etr.predict(test_X)
    
    # For quick_mae used in model selection, we just need one metric.
    # Use 4-week MAE for this internal selection.
    return median_absolute_error(test_y[-4:], pred[-4:])


def ml(region, data_cutoff_date, chg_full, tot_full, fdy_full, wwk_full, lng_full, 
        weekly_salt_crit_df_full, weekly_nsalt_crit_df_full, pos_full, price_full, 
        weekly_platts_full, henry_flow_full, use_henry_flow, use_enhanced_weather, 
        use_criterion, use_platts, regions_use_pos, regions_use_price, return_full_data=False): 
    
    def _filter_df_by_date(df, date_col='Date'):
        if df is None: return None
        if date_col is None and isinstance(df.index, pd.DatetimeIndex):
            return df[df.index <= data_cutoff_date].copy()
        elif date_col in df.columns:
            return df[df[date_col] <= data_cutoff_date].copy()
        else:
            # If date_col is not in columns and index is not datetime, try to use index
            try:
                return df[df.index <= data_cutoff_date].copy()
            except TypeError:
                print(f"Warning: Cannot filter DataFrame by date. Date column/index not found or not datetime-like. DataFrame columns: {df.columns.tolist()}")
                return df # Return unfiltered if date column/index is problematic


    chg = _filter_df_by_date(chg_full, date_col=None)
    tot = _filter_df_by_date(tot_full, date_col=None)
    fdy = _filter_df_by_date(fdy_full)
    wwk = _filter_df_by_date(wwk_full, date_col=None)
    lng = _filter_df_by_date(lng_full)
    weekly_salt_crit_df = _filter_df_by_date(weekly_salt_crit_df_full, date_col=None)
    weekly_nsalt_crit_df = _filter_df_by_date(weekly_nsalt_crit_df_full, date_col=None)
    pos_df = _filter_df_by_date(pos_full, date_col=None)
    price_df = _filter_df_by_date(price_full, date_col=None)
    weekly_platts = _filter_df_by_date(weekly_platts_full, date_col=None)
    henry_flow_df = _filter_df_by_date(henry_flow_full)

    tgt_col_name = f"{region} Storage Change (Bcf)"
    if region == "South Central Region":
        salt_col = "Salt Region SC Storage Change (Bcf)"
        nonsalt_col = "Nonsalt Region SC Storage Change (Bcf)"
        if salt_col in chg.columns and nonsalt_col in chg.columns:
            df = pd.DataFrame({"Target": chg[salt_col] + chg[nonsalt_col]})
        elif tgt_col_name in chg.columns: 
            df = pd.DataFrame({"Target": chg[tgt_col_name]})
        else:
            return np.nan, np.nan, np.nan, np.nan, np.nan, None, None
    elif tgt_col_name in chg.columns:
        df = pd.DataFrame({"Target": chg[tgt_col_name]})
    else:
        return np.nan, np.nan, np.nan, np.nan, np.nan, None, None


    internal_cutoff = chg.index.max() - pd.DateOffset(years=5)
    df = df[df.index >= internal_cutoff]
    if df.empty:
        return np.nan, np.nan, np.nan, np.nan, np.nan, None, None

    if region=="Lower 48 States":
        lvl = "Lower 48 States Storage (Bcf)"
        if lvl in tot.columns:
            df["StorageDelta"] = tot[lvl] - tot[lvl].rolling(260,52).mean()
        
        if "HistoricalSumOfParts" in chg.columns:
            df["SoP_lag1"] = chg["HistoricalSumOfParts"].shift(1)
            df["DeltaSoP_lag1"] = chg["HistoricalSumOfParts"].diff(1).shift(1)

    fundy_prefixes = FUNDY_MAP.get(region, [])
    fundy_wide = None
    if fundy_prefixes and fdy is not None:
        fundy_wide = fdy.pivot_table(index='Date', columns='item', values='value').clip(-2e5, 2e5)
        need_cols = [c for p in fundy_prefixes for c in fundy_wide.columns
                     if c.startswith(p) and any(b_item in c for b_item in BEST_FUN)]
        if need_cols:
            df = df.join(fundy_wide[need_cols].resample('W-FRI').sum(), how='left')

    # Weather Features
    df_weather_features = pd.DataFrame(index=df.index)
    if use_enhanced_weather and wwk is not None:
        city = REGION_CITY[region]
        weather_filtered = wwk.filter(like=f"{city}_")
        if not weather_filtered.empty:
            df_weather_features = weather_filtered.copy()
            for suffix in ["_CDD", "_HDD"]:
                col = f"{city}{suffix}"
                if col in df_weather_features.columns:
                    base = df_weather_features[col]
                    if len(base.dropna()) >= 260:
                        clim = base.rolling(260, min_periods=104).mean()
                        df_weather_features[f"{col}_anom"] = base - clim
            
            if region == "South Central Region":
                ercot_cdd_col = f"{REGION_CITY['South Central Region']}_CDD"
                if ercot_cdd_col in df_weather_features.columns:
                    ercot_base = df_weather_features[ercot_cdd_col]
                    if len(ercot_base.dropna()) >= 260:
                        ercot_clim = ercot_base.rolling(260, min_periods=104).mean()
                        df_weather_features["ERCOT_CDD_anom"] = ercot_base - ercot_clim

    # Criterion features (LNG, Pipe Imports, Salt/Non-Salt)
    if use_criterion:
        if lng is not None and "Region" in lng.columns:
            lng_week = lng[lng["Region"]==region].set_index("Date")[["LNG_Bcf"]].resample("W-FRI").sum()
            if not lng_week.empty:
                if region == "South Central Region" and "LNG_Bcf" in lng_week.columns:
                    df["LNG_Weekly"] = lng_week["LNG_Bcf"]
                    df["LNG_lag1"] = lng_week["LNG_Bcf"].shift(1)
                    df["LNG_lag2"] = lng_week["LNG_Bcf"].shift(2)
                else:
                    df = df.join(lng_week.rename(columns={"LNG_Bcf":"LNG_Weekly"}), how="left")

        if region == "Midwest Region" and fundy_wide is not None:
            pipe_imports_col_name = "Midwest - PipeImports"
            if pipe_imports_col_name in fundy_wide.columns:
                mid_imp_series = fundy_wide[pipe_imports_col_name]
                if not mid_imp_series.dropna().empty:
                    df["CanImp"] = mid_imp_series.reindex(df.index)
                    df["CanImp_lag1"] = mid_imp_series.shift(1).reindex(df.index)

        if weekly_salt_crit_df is not None and weekly_nsalt_crit_df is not None:
            if region in ["South Central Region", "Lower 48 States"]:
                all_crit_dfs = {'Salt': weekly_salt_crit_df, 'NSalt': weekly_nsalt_crit_df}
                for prefix, src_df in all_crit_dfs.items():
                    if region == "Lower 48 States":
                        l48_crit_cols = [c for c in src_df.columns if c.startswith(prefix + '_')]
                        if l48_crit_cols:
                            l48_sum_col_name = f"{prefix}_L48_Total"
                            summed_series = src_df[l48_crit_cols].sum(axis=1)
                            df = df.join(summed_series.rename(l48_sum_col_name), how='left')
                    else:
                        col_name = f"{prefix}_{region}"
                        if col_name in src_df.columns:
                            df = df.join(src_df[[col_name]], how='left')

    # Platts features (Positioning, Price, CONUS Fundamentals)
    if use_platts:
        if pos_df is not None and region in regions_use_pos: 
            df = df.join(pos_df, how="left") 
        
        if price_df is not None and region in regions_use_price: 
            df = df.join(price_df, how="left")
        
        if weekly_platts is not None and not weekly_platts.empty: 
            df = df.join(weekly_platts, how="left")

    # Henry Flow features
    if use_henry_flow: 
        df = add_henry_features_to_df(df, df.index, henry_flow_df)

    df["Summer"] = ((df.index.month >= 5) & (df.index.month <= 9)).astype(int)
    df["Target_lag1"] = df["Target"].shift(1)
    df["Target_lag2"] = df["Target"].shift(2)

    df = add_cal(df)
    
    df_cleaned = df.dropna()
    if df_cleaned.empty:
        return np.nan, np.nan, np.nan, np.nan, np.nan, None, None

    y_full_filtered = df_cleaned.pop("Target")
    X_base = df_cleaned.copy()

    # The weather feature selection logic is still needed for use_enhanced_weather
    # even if use_enhanced_weather is True based on region_toggles.
    # This allows it to check if weather actually improves MAE for the specific region.
    X_wthr = X_base.join(df_weather_features.reindex(X_base.index).dropna(how='all'), how='left')
    
    mae_base = calculate_maes(X_base, y_full_filtered)
    mae_wthr = calculate_maes(X_wthr, y_full_filtered)

    force_no_weather = region in NEVER_USE_WEATHER
    force_yes_weather = region in ALWAYS_USE_WEATHER 

    # Determine final use of weather based on performance
    # This overrides the initial `use_enhanced_weather` toggle if manual overrides or MAE dictate.
    use_weather_in_model = False
    if force_no_weather:
        use_weather_in_model = False
    elif force_yes_weather: 
        use_weather_in_model = True
    elif mae_base == np.inf and mae_wthr == np.inf:
        use_weather_in_model = False
    elif mae_base == np.inf: 
        use_weather_in_model = True
    elif mae_wthr == np.inf:
        use_weather_in_model = False
    else: 
        use_weather_in_model = mae_wthr + 0.01 < mae_base 

    chosen_X = X_wthr if use_weather_in_model else X_base
    
    y = y_full_filtered 
    X = chosen_X

    # Ensure X and y are aligned and have enough data
    if X.empty or y.empty or len(X) < 12: # Need at least 12 data points for 12-week MAE
        return np.nan, np.nan, np.nan, np.nan, np.nan, None, None


    scaler = StandardScaler(); Xs = scaler.fit_transform(X)
    
    ridge  = RidgeCV(alphas=[0.1,1.0,10.0]).fit(Xs,y)

    if USE_LIGHTGBM:
        etr = LGBMRegressor(**GBM_PARAMS).fit(X, y)
    else:
        etr = ExtraTreesRegressor(n_estimators=300, random_state=42).fit(X,y)
    
    R_W, G_W = 0.40, 0.60

    all_preds_ridge = ridge.predict(Xs)
    all_preds_etr = etr.predict(X)
    all_combined_preds = R_W * all_preds_ridge + G_W * all_preds_etr

    ml_fc  = all_combined_preds[-1]

    mae_4wk = np.nan
    mae_12wk = np.nan
    
    if len(y) >= 4:
        mae_4wk = median_absolute_error(y.iloc[-4:], all_combined_preds[-4:])
    if len(y) >= 12:
        mae_12wk = median_absolute_error(y.iloc[-12:], all_combined_preds[-12:])

    if return_full_data:
        return ml_fc, mae_4wk, mae_12wk, all_combined_preds, y # Corrected: mae12 -> mae_12wk
    else:
        return ml_fc, mae_4wk, mae_12wk # Corrected: mae12 -> mae_12wk


