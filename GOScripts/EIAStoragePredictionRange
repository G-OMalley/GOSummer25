# Helper to get actuals, particularly for South Central
def _get_regional_actual(chg_df, target_date, region_name):
    if target_date not in chg_df.index:
        return np.nan

    if region_name == "South Central Region":
        salt_col = "Salt Region SC Storage Change (Bcf)"
        nonsalt_col = "Nonsalt Region SC Storage Change (Bcf)"
        if salt_col in chg_df.columns and nonsalt_col in chg_df.columns:
            return chg_df.loc[target_date, salt_col] + chg_df.loc[target_date, nonsalt_col]
        else:
            return chg_df.loc[target_date, "South Central Region Storage Change (Bcf)"] if "South Central Region Storage Change (Bcf)" in chg_df.columns else np.nan
    else:
        col_name = f"{region_name} Storage Change (Bcf)"
        return chg_df.loc[target_date, col_name] if col_name in chg_df.columns else np.nan

# Define a wrapper for ml function for the dual forecast
def run_region_model(region, **kwargs):
    """
    Wrapper function to call ml with pre-loaded full data and return
    forecast, 4wk_MAE, and 12wk_MAE.
    This simulates the assumption for the dual forecast block.
    """
    # These global variables need to be passed down or accessed by run_region_model
    # For simplicity, they are passed as attributes of the function here from main.
    _chg_full, _tot_full, _fdy_full, _wwk_full, _lng_full, \
    _weekly_salt_crit_df_full, _weekly_nsalt_crit_df_full, _pos_full, \
    _price_full, _weekly_platts_full, _henry_flow_full, _latest_eia_date = (
        run_region_model._chg_full, run_region_model._tot_full, run_region_model._fdy_full,
        run_region_model._wwk_full, run_region_model._lng_full,
        run_region_model._weekly_salt_crit_df_full, run_region_model._weekly_nsalt_crit_df_full,
        run_region_model._pos_full, run_region_model._price_full,
        run_region_model._weekly_platts_full, run_region_model._henry_flow_full,
        run_region_model._latest_eia_date
    )

    forecast, mae4, mae12, _, _ = ml(
        region,
        _latest_eia_date,
        _chg_full, _tot_full, _fdy_full, _wwk_full, _lng_full,
        _weekly_salt_crit_df_full, _weekly_nsalt_crit_df_full, _pos_full,
        _price_full, _weekly_platts_full, _henry_flow_full,
        use_henry_flow=kwargs.get("use_henry", False),
        use_enhanced_weather=kwargs.get("enhance_weather", False), 
        use_criterion=kwargs.get("use_criterion", False),
        use_platts=kwargs.get("use_platts", False),
        regions_use_pos=REGIONS_USE_POS, # Use global constants here
        regions_use_price=REGIONS_USE_PRICE, # Use global constants here
        return_full_data=True # We need MAEs for the dual forecast logic
    )
    return forecast, mae4, mae12


def main():
    print("Loading...")

    # Load all full datasets once and store them as attributes of run_region_model
    # so they can be accessed by the wrapper without re-loading.
    chg_full, tot_full, fdy_full, wth_full = core_data()
    if any(df is None for df in [chg_full, tot_full, fdy_full, wth_full]):
        sys.exit("❌ One or more core CSV files are missing. Please check the INFO directory.")

    wwk_full = weekly_weather(wth_full)
    lng_full = lng_data()
    pos_full = positioning_data()
    price_full = make_price_features()

    henry_flow_full = get_csv("CriterionHenryFlows.csv", ["Date"]) 
    if henry_flow_full is None:
        print("Warning: CriterionHenryFlows.csv not found. Henry Flow features will not be used.")

    platts_conus_path = DATA_DIR / "PlattsCONUSFundamentalsHIST.csv"
    platts_conus_full = None
    try:
        # Load without parsing dates initially
        platts_conus_raw = pd.read_csv(platts_conus_path) 
        
        # Check for 'GasDate' and 'GasDay' and prioritize 'GasDate' if it exists
        date_col_name = None
        if 'GasDate' in platts_conus_raw.columns:
            date_col_name = 'GasDate'
        elif 'GasDay' in platts_conus_raw.columns:
            date_col_name = 'GasDay'
        
        if date_col_name is None:
            raise ValueError("Neither 'GasDay' nor 'GasDate' column found in PlattsCONUSFundamentalsHIST.csv.")
            
        # Manually parse the identified date column ensuring it's a datetime object, coercing errors
        platts_conus_raw[date_col_name] = pd.to_datetime(platts_conus_raw[date_col_name], errors='coerce')
        platts_conus_raw = platts_conus_raw.dropna(subset=[date_col_name])
        
        # Rename the identified date column to 'Date' and set as index
        platts_conus_full = platts_conus_raw.rename(columns={date_col_name: "Date"}).set_index("Date").sort_index()
    except Exception as e:
        print(f"Warning: Could not load or process PlattsCONUSFundamentalsHIST.csv from {platts_conus_path}. Error: {e}. Platts fundamentals will not be used.")
        platts_conus_full = None # Explicitly set to None on error

    selected_platts_features = [
        "DryGasProduction", "MexExp", "LNGExports", 
        "PowerBurn", "ResComDemand", "NetImpliedFlow"
    ]
    
    weekly_platts_full = None
    if platts_conus_full is not None and not platts_conus_full.empty:
        existing_platts_features = [f for f in selected_platts_features if f in platts_conus_full.columns]
        if existing_platts_features:
            weekly_platts_full = platts_conus_full[existing_platts_features].resample("W-FRI").mean().dropna()

    locs = get_csv("locs_list.csv", [])
    
    weekly_salt_crit_df_full = None 
    weekly_nsalt_crit_df_full = None 

    required_locs_cols = ['storage_name', 'state_name', 'storage_type']
    if locs is not None and all(col in locs.columns for col in required_locs_cols):
        crit_full = get_csv("CriterionStorageChange.csv", ["eff_gas_day"])
        if crit_full is not None:
            crit_full = (crit_full.merge(locs[required_locs_cols], 
                                         on='storage_name', how='left')
                                         .dropna(subset=['state_name','storage_type'])) 

            crit_full['Region'] = crit_full['state_name'].map(STATE_TO_REGION)
            crit_full = crit_full.dropna(subset=['Region']) 
            crit_full.set_index('eff_gas_day', inplace=True)

            weekly_salt_crit_df_full = (crit_full[crit_full['storage_type'].str.contains('salt',case=False)]
                                    .groupby([pd.Grouper(freq='W-FRI'), 'Region'])['daily_storage_change']
                                    .sum()
                                    .unstack('Region')
                                    .add_prefix('Salt_'))
            weekly_nsalt_crit_df_full = (crit_full[~crit_full['storage_type'].str.contains('salt',case=False)]
                                     .groupby([pd.Grouper(freq='W-FRI'), 'Region'])['daily_storage_change']
                                     .sum()
                                     .unstack('Region')
                                     .add_prefix('NSalt_'))

    l48_sum_cols_for_sop = [f"{r} Storage Change (Bcf)" for r in REGIONS if r not in ["Lower 48 States", "South Central Region"]]
    if "South Central Region Storage Change (Bcf)" in chg_full.columns:
        l48_sum_cols_for_sop.append("South Central Region Storage Change (Bcf)")
    
    existing_l48_sum_cols = [col for col in l48_sum_cols_for_sop if col in chg_full.columns]
    
    if existing_l48_sum_cols:
        chg_full["HistoricalSumOfParts"] = chg_full[existing_l48_sum_cols].sum(axis=1)
    else:
        chg_full["HistoricalSumOfParts"] = np.nan 

    latest_eia_date = chg_full.index.max()
    forecast_date = latest_eia_date + pd.Timedelta(days=7)

    # Store full data on the run_region_model function object
    # so it can be accessed within the dual forecast loop without re-loading
    run_region_model._chg_full = chg_full
    run_region_model._tot_full = tot_full
    run_region_model._fdy_full = fdy_full
    run_region_model._wwk_full = wwk_full
    run_region_model._lng_full = lng_full
    run_region_model._weekly_salt_crit_df_full = weekly_salt_crit_df_full
    run_region_model._weekly_nsalt_crit_df_full = weekly_nsalt_crit_df_full
    run_region_model._pos_full = pos_full
    run_region_model._price_full = price_full
    run_region_model._weekly_platts_full = weekly_platts_full
    run_region_model._henry_flow_full = henry_flow_full
    run_region_model._latest_eia_date = latest_eia_date # Passed to ml for internal data filtering

    print("\n========================= Running Dual Forecast Execution =========================")

    # --- Best 4wk MAE Configs --- 
    region_settings_4wk = {
        "East Region":          {"use_criterion": False, "enhance_weather": True,  "use_henry": False, "use_platts": True},
        "Midwest Region":       {"use_criterion": True,  "enhance_weather": False, "use_henry": True,  "use_platts": False},
        "South Central Region": {"use_criterion": False, "enhance_weather": False, "use_henry": False, "use_platts": True},
        "Mountain Region":      {"use_criterion": True,  "enhance_weather": True,  "use_henry": False, "use_platts": True},
        "Pacific Region":       {"use_criterion": False, "enhance_weather": True,  "use_henry": False, "use_platts": True},
        "Lower 48 States":      {"use_criterion": True,  "enhance_weather": True,  "use_henry": True,  "use_platts": False},
    }
    # --- Best 12wk MAE Configs --- 
    region_settings_12wk = {
        "East Region":          {"use_criterion": False, "enhance_weather": False, "use_henry": False, "use_platts": False},
        "Midwest Region":       {"use_criterion": False, "enhance_weather": False, "use_henry": False, "use_platts": False},
        "South Central Region": {"use_criterion": False, "enhance_weather": False, "use_henry": False, "use_platts": False},
        "Mountain Region":      {"use_criterion": False, "enhance_weather": False, "use_henry": False, "use_platts": False},
        "Pacific Region":       {"use_criterion": False, "enhance_weather": False, "use_henry": False, "use_platts": False},
        "Lower 48 States":      {"use_criterion": False, "enhance_weather": False, "use_henry": False, "use_platts": False},
    }

    # === Final Output ===
    output_rows = []

    for region in REGIONS: # Loop through the global REGIONS list to ensure all are processed
        print(f"\n==== Forecasting {region} ====")

        # --- Run 4-week optimized model ---
        cfg4 = region_settings_4wk.get(region, {})
        if not cfg4:
            print(f"Warning: 4-week settings not found for {region}. Skipping 4-week forecast for this region.")
            f4, mae4_from_4wk_cfg, mae12_from_4wk_cfg = np.nan, np.nan, np.nan
        else:
            # run_region_model returns (forecast, 4wk_mae, 12wk_mae)
            f4, mae4_from_4wk_cfg, mae12_from_4wk_cfg = run_region_model(region, **cfg4)

        # --- Run 12-week optimized model ---
        cfg12 = region_settings_12wk.get(region, {})
        if not cfg12:
            print(f"Warning: 12-week settings not found for {region}. Skipping 12-week forecast for this region.")
            f12, mae4_from_12wk_cfg, mae12_from_12wk_cfg = np.nan, np.nan, np.nan
        else:
            f12, mae4_from_12wk_cfg, mae12_from_12wk_cfg = run_region_model(region, **cfg12)

        # --- Forecast range ---
        valid_forecasts = [val for val in [f4, f12] if not np.isnan(val)]

        low, high = np.nan, np.nan
        forecast_range_str = "N/A"

        if len(valid_forecasts) == 1:
            low = high = valid_forecasts[0]
            forecast_range_str = f"[{low:.2f}, {high:.2f}] (Single valid forecast)"
        elif len(valid_forecasts) == 2:
            low, high = sorted(valid_forecasts)
            forecast_range_str = f"[{low:.2f}, {high:.2f}]"
        
        output_rows.append({
            "Region": region,
            "Forecast Range (Bcf)": forecast_range_str,
            "4wk Forecast": round(f4, 2) if not np.isnan(f4) else np.nan,
            "12wk Forecast": round(f12, 2) if not np.isnan(f12) else np.nan,
            "4wk MAE": round(mae4_from_4wk_cfg, 2) if not np.isnan(mae4_from_4wk_cfg) else np.nan,
            "12wk MAE": round(mae12_from_12wk_cfg, 2) if not np.isnan(mae12_from_12wk_cfg) else np.nan,
            "Forecast Date": forecast_date.date()
        })

    # --- Save output ---
    output_df = pd.DataFrame(output_rows)

    print("\n=== STORAGE FORECAST RANGE RESULTS ===")
    print(tabulate(output_df, headers="keys", tablefmt="pipe", showindex=False))

    range_output_path = G_OUTPUT_DIR / "EIAStoragePred_Range.csv"
    try:
        output_df.to_csv(range_output_path, index=False, float_format="%.2f")
        print(f"\nForecast Range CSV written to: {range_output_path}\n")
    except PermissionError:
        print(f"\nERROR: Permission denied when writing to '{range_output_path}'.")
        print("Please ensure the file is not open in another program (e.g., Excel) and try again.")
        print(f"Attempting to save to a temporary file: '{range_output_path.parent / (range_output_path.stem + '_temp' + range_output_path.suffix)}'")
        output_df.to_csv(range_output_path.parent / (range_output_path.stem + '_temp' + range_output_path.suffix), index=False, float_format="%.2f")
    except Exception as e:
        print(f"\nERROR: An unexpected error occurred when writing the Forecast Range CSV: {e}")


if __name__ == "__main__":
    main()