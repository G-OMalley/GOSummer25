#!/usr/bin/env python3
"""
StorageReactions.py  –  storage + weather analog, console‑only
Prints:
  • Back‑test hit‑rate (8 wks)
  • Henry Hub flat‑price analog
  • BUY/SELL trade blotter (+1 wk)
No CSVs produced.
"""

import pandas as pd, numpy as np, sys
from pathlib import Path
from datetime import timedelta

# ===== USER SETTINGS =====
MIN_ABS_MOVE  = 0.025   # 2.5 ¢ move threshold
MIN_ANALOGS   = 1       # ≥1 analog year
BACKTEST_WKS  = 8
HENRY_COL     = "Henry"
FFILL_DAYS    = 7
# ==========================

# ---------- Load core data ----------
root     = Path(__file__).resolve().parent.parent / "INFO"
eia      = pd.read_csv(root / "EIAtotals.csv", parse_dates=["Period"])
prices   = pd.read_csv(root / "PRICES.csv").rename(columns=str.strip)
weather  = pd.read_csv(root / "WEATHER.csv")
city_map = pd.read_csv(root / "CITY_EIA_MAPPING.csv")

# --- sanity checks
if HENRY_COL not in prices.columns:
    sys.exit(f"Henry column '{HENRY_COL}' missing in PRICES.csv")

# ---------- Pre‑process prices ----------
prices["Date"] = pd.to_datetime(prices["Date"], errors="coerce")
prices = prices.dropna(subset=["Date"])
for c in prices.columns:
    if c != "Date":
        prices[c] = pd.to_numeric(prices[c], errors="coerce")

def make_basis(df: pd.DataFrame) -> pd.DataFrame:
    b = df.set_index("Date").sort_index()
    b = b.ffill(limit=FFILL_DAYS).bfill(limit=FFILL_DAYS)
    for col in b.columns:
        if col != HENRY_COL:
            b[col] = b[col] - b[HENRY_COL]
    return b.drop(columns=[HENRY_COL])

basis = make_basis(prices)

# ---------- Pre‑process weather ----------
weather["Date"] = pd.to_datetime(weather["Date"], errors="coerce")
weather = weather.merge(city_map,
                        left_on="City Title",
                        right_on="City Title",
                        how="left")
weather = weather.dropna(subset=["EIA Region", "Date"])
weather["Week"]  = weather["Date"].dt.isocalendar().week
weather["Year"]  = weather["Date"].dt.year
weather["NetDD"] = weather["CDD"] - weather["HDD"]
weekly_wx = (weather.groupby(["EIA Region","Year","Week"])
                     .agg(NetDD=("NetDD","sum"))
                     .reset_index())

# ---------- region column names ----------
REGION_INFO = {
    "East":"East Region Storage (Bcf)",
    "Midwest":"Midwest Region Storage (Bcf)",
    "Mountain":"Mountain Region Storage (Bcf)",
    "Pacific":"Pacific Region Storage (Bcf)",
    "South Central":"South Central Region Storage (Bcf)",
    "Lower 48":"Total Lower 48 Storage (Bcf)"
}

# ---------- hub → region map (short sample) ----------
R = {"E":"East","M":"Midwest","S":"South Central",
     "P":"Pacific","Mt":"Mountain"}
COMPONENT_TO_REGION = {
    "Transco-165":R["S"],"Panhandle":R["M"],"Waha":R["S"],
    # ← copy the full mapping list you already maintain →
}
# auto‑map stray hubs
for h in [c for c in prices.columns if c not in ("Date",HENRY_COL) and c not in COMPONENT_TO_REGION]:
    COMPONENT_TO_REGION[h] = "Lower 48"

# ---------- helpers ----------
def near(idx, ts):
    loc = idx.searchsorted(ts)
    if loc == 0: return idx[0]
    if loc == len(idx): return idx[-1]
    before, after = idx[loc-1], idx[loc]
    return before if abs(ts-before) < abs(ts-after) else after

def wx_ok(region:str, yr:int, wk:int, cur_yr:int)->bool:
    """return True if weather delta sign matches today's."""
    cur = weekly_wx.query("`EIA Region`==@region and Year==@cur_yr and Week==@wk")
    nxt = weekly_wx.query("`EIA Region`==@region and Year==@cur_yr and Week==@wk+1")
    ana = weekly_wx.query("`EIA Region`==@region and Year==@yr      and Week==@wk")
    anx = weekly_wx.query("`EIA Region`==@region and Year==@yr      and Week==@wk+1")
    if cur.empty or nxt.empty or ana.empty or anx.empty:
        return True  # no weather data → don’t veto
    cur_sign = np.sign(nxt.NetDD.values[0] - cur.NetDD.values[0])
    ana_sign = np.sign(anx.NetDD.values[0] - ana.NetDD.values[0])
    return cur_sign == 0 or ana_sign == 0 or cur_sign == ana_sign

# ---------- analog routine ----------
def analog(anchor: pd.Timestamp):
    wk = anchor.isocalendar().week
    cur_row = eia[eia["Period"]==anchor].iloc[0]
    cur_st  = {r:cur_row.get(col,np.nan) for r,col in REGION_INFO.items()}
    fiveyr  = eia[(eia["Period"].dt.year >= anchor.year-5) &
                  (eia["Period"].dt.isocalendar().week == wk)]
    subset  = eia[eia["Period"].dt.isocalendar().week == wk]

    trades=[]
    for hub, reg in COMPONENT_TO_REGION.items():
        if hub not in basis.columns or pd.isna(cur_st.get(reg)): continue
        tol = 0.03 if cur_st[reg] < fiveyr[REGION_INFO[reg]].mean() else 0.07
        yrs, moves = [], []
        for _, row in subset.iterrows():
            scol = REGION_INFO[reg]
            if pd.isna(row[scol]): continue
            if abs(row[scol]-cur_st[reg])/cur_st[reg] <= tol \
               and row["Period"].year != anchor.year \
               and wx_ok(reg, row["Period"].year, wk, anchor.year):

                yrs.append(row["Period"].year)
                ad = row["Period"]
                b0 = basis.loc[near(basis.index, ad), hub]
                b1 = basis.loc[near(basis.index, ad + timedelta(weeks=1)), hub]
                if not pd.isna(b0) and not pd.isna(b1):
                    moves.append(b1 - b0)

        if not moves: continue
        if len(moves) >= 2 and np.ptp(np.sign(moves)) > 0: continue
        m = np.mean(moves)
        if abs(m) < MIN_ABS_MOVE: continue
        trades.append({
            "Region": reg,
            "Component": hub,
            "Move¢": round(m*100,1),
            "Action": "BUY basis ⬆" if m>0 else "SELL basis ⬇",
            "Years": ",".join(map(str, sorted(set(yrs))))
        })

    # --------------- Henry Hub ---------------
    hh_moves, hh_yrs = [], []
    for _, row in subset.iterrows():
        if abs(row["Total Lower 48 Storage (Bcf)"] - cur_st["Lower 48"]) / cur_st["Lower 48"] <= 0.05 \
           and row["Period"].year != anchor.year \
           and wx_ok("South Central", row["Period"].year, wk, anchor.year):

            hh_yrs.append(row["Period"].year)
            ad = row["Period"]
            p0 = prices.loc[near(prices["Date"].values, ad), HENRY_COL]
            p1 = prices.loc[near(prices["Date"].values, ad + timedelta(weeks=1)), HENRY_COL]
            if not pd.isna(p0) and not pd.isna(p1):
                hh_moves.append(p1 - p0)
    hh = None
    if hh_moves and (len(hh_moves)==1 or np.ptp(np.sign(hh_moves))==0):
        hh = {"Dir":"UP" if np.mean(hh_moves)>0 else "DOWN",
              "Move¢": round(np.mean(hh_moves)*100,1),
              "Years": ",".join(map(str, sorted(set(hh_yrs))))}
    return trades, hh

# ---------- Back‑test ----------
fridays = eia["Period"].drop_duplicates().sort_values()
latest  = fridays.max()
bt_dates = fridays.iloc[-(BACKTEST_WKS+1):-1]

bt_tot = bt_hit = 0
for d in bt_dates:
    sig, _ = analog(d)
    for r in sig:
        hub = r["Component"]; pm = r["Move¢"]/100
        s = basis.loc[near(basis.index, d), hub]
        e = basis.loc[near(basis.index, d+timedelta(weeks=1)), hub]
        if pd.isna(s)|pd.isna(e): continue
        bt_tot += 1
        if np.sign(pm) == np.sign(e-s): bt_hit += 1

print(f"\n🔎 Back‑test {BACKTEST_WKS} wks Hit‑Rate: "
      f"{bt_hit/bt_tot*100:.1f}% on {bt_tot} trades" if bt_tot else
      "\n⚠️  No qualifying trades in back‑test window.")

# ---------- Live ----------
trades, hh = analog(latest)

if hh:
    print(f"\nHenry Hub analog (+1 wk): {hh['Dir']} {hh['Move¢']} ¢ "
          f"(years {hh['Years']})")
else:
    print("\nHenry Hub analog: no match")

if trades:
    print("\n=== 🔔 TRADE BLOTTER (+1 wk) ===")
    for r in trades:
        print(f"{r['Region']:13} {r['Component']:<25} "
              f"{r['Action']:14} {r['Move¢']:>6} ¢   yrs {r['Years']}")
else:
    print("\n📭  No pipelines met filters for the latest period.")
