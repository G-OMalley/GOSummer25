# ------------------------------------------

# ----- LOAD DATA -----
# Determine the script's directory and then the INFO directory relative to it.
script_dir = Path(__file__).resolve().parent
info_dir = script_dir.parent / "INFO"

# Load EIA totals data from the CSV file.
eia_totals = pd.read_csv(info_dir / "EIAtotals.csv", parse_dates=["Period"])

# Load prices data from the CSV file.
# Clean column names immediately to handle any trailing spaces.
prices = pd.read_csv(info_dir / "PRICES.csv", sep=',').rename(columns=str.strip)

# Drop any unnamed columns that might result from malformed CSVs
prices = prices.loc[:, ~prices.columns.str.contains('^Unnamed', na=False)]

# Robustly convert 'Date' column to datetime, coercing errors to NaT
prices["Date"] = pd.to_datetime(prices["Date"], errors='coerce', dayfirst=False)

# Drop rows where Date conversion failed
prices.dropna(subset=["Date"], inplace=True)

# Check if Henry Hub column exists *before* attempting basis calculation
if HENRY_COL not in prices.columns:
    raise ValueError(f"CRITICAL ERROR: Henry Hub column '{HENRY_COL}' not found in PRICES.csv. Please check the column name in your CSV and the HENRY_COL variable in the script.")

# Convert all price columns to numeric, coercing errors to NaN
for col in prices.columns:
    if col != "Date":
        prices[col] = pd.to_numeric(prices[col], errors='coerce')

# --- HELPER: BASIS ---
def compute_basis(df: pd.DataFrame) -> pd.DataFrame:
    """
    Computes the basis for each component by subtracting the Henry Hub price.
    Basis is defined as (Component Price - Henry Hub Price).

    Args:
        df (pd.DataFrame): DataFrame containing daily hub prices, including Henry Hub.

    Returns:
        pd.DataFrame: DataFrame with basis values for each component.
    """
    basis_df = df.set_index("Date").copy()

    # Ensure the index is a DatetimeIndex and sort it
    if not isinstance(basis_df.index, pd.DatetimeIndex):
        basis_df.index = pd.to_datetime(basis_df.index)
    basis_df = basis_df.sort_index()

    # Fill any NaN values in price data using forward and then backward fill, with a limited scope.
    basis_df = basis_df.ffill(limit=FFILL_LIMIT_DAYS).bfill(limit=FFILL_LIMIT_DAYS)

    # Perform basis calculation: Component Price - Henry Hub Price
    for col in basis_df.columns:
        if col == HENRY_COL:
            continue # Skip Henry Hub itself
        basis_df[col] = basis_df[col] - basis_df[HENRY_COL]

    # Remove Henry Hub column after basis calculation
    basis_df = basis_df.drop(columns=[HENRY_COL], errors='ignore')
    return basis_df

# Calculate the basis for all components using the prices DataFrame.
basis = compute_basis(prices)

# --- CURRENT EARLY‑JUNE STORAGE ---
# Get the latest period available in the EIA totals data.
latest_period = eia_totals["Period"].max()
# Determine the ISO week number of the latest period.
current_iso_week = latest_period.isocalendar().week

# Find the current early-June storage record.
eia_totals['Period'] = pd.to_datetime(eia_totals['Period'])
eia_early_june = eia_totals[eia_totals["Period"].dt.isocalendar().week == EARLY_JUNE_ISO_WEEK]

# Use the most recent early-June data if current period isn't early June
if current_iso_week != EARLY_JUNE_ISO_WEEK:
    if eia_early_june.empty:
        raise ValueError("No early-June data found in EIAtotals.csv to establish current storage for any year.")
    current_record = eia_early_june.sort_values("Period").iloc[-1]
else:
    # If the latest period is already early June, use it directly.
    current_record_candidates = eia_totals[eia_totals['Period'] == latest_period]
    if current_record_candidates.empty:
        raise ValueError(f"Could not find a record for the latest period {latest_period.date()} in EIAtotals.csv.")
    current_record = current_record_candidates.iloc[0]

# Store current storage levels for relevant regions.
current_storage = {}
for reg, col_name in REGION_INFO.items():
    current_storage[reg] = current_record.get(col_name, np.nan)


# --- FIND ANALOG YEARS PER REGION ---
def analog_years(region: str) -> list[int]:
    """
    Finds and returns a list of years where the early-June storage for a given
    region was within the specified tolerance of the current storage level.

    Args:
        region (str): The name of the region (e.g., "East", "Midwest", "South Central").

    Returns:
        list[int]: A sorted list of analog years, excluding the current year.
    """
    analogs = []
    regional_col = REGION_INFO[region] # Pull the column name directly from REGION_INFO

    subset = eia_totals[eia_totals["Period"].dt.isocalendar().week == EARLY_JUNE_ISO_WEEK]

    if regional_col not in subset.columns:
        print(f"Warning: Regional column '{regional_col}' not found in EIAtotals.csv. Cannot find analogs for {region}.")
        return []

    if region not in current_storage or pd.isna(current_storage[region]):
        print(f"Warning: Current storage for region '{region}' is unavailable or NaN. Cannot find analogs.")
        return []

    for _, row in subset.iterrows():
        if not pd.isna(row[regional_col]):
            if abs(row[regional_col] - current_storage[region]) <= TOLERANCE_BCF:
                analogs.append(row["Period"].year)

    # Exclude the latest period's year from analog years
    return sorted(set(analogs) - {latest_period.year})

# --- HELPER to fetch nearest date ---
# Moved this function definition here, before its first call.
def nearest_date(idx: pd.DatetimeIndex, target_ts: pd.Timestamp) -> pd.Timestamp:
    """
    Return the closest timestamp in idx to target_ts.
    Assumes idx is a sorted pd.DatetimeIndex.
    """
    loc = idx.searchsorted(target_ts)

    if loc == 0: # Target is before or at the first element
        return idx[0]
    if loc == len(idx): # Target is after or at the last element
        return idx[loc - 1]

    # Compare with the element at loc and the one before it
    before = idx[loc - 1]
    after = idx[loc]

    if abs(target_ts - before) < abs(target_ts - after):
        return before
    else:
        return after

records = [] # List to store individual price move records.

# Iterate through each component and its assigned region.
for comp_key_stripped, region in COMPONENT_TO_REGION.items(): # Using the new COMPONENT_TO_REGION map
    if comp_key_stripped not in basis.columns:
        # Suppress warning specifically for Henry Hub as it's the basis and removed
        if comp_key_stripped == HENRY_COL:
            continue
        print(f"Warning: Component '{comp_key_stripped}' not found in prices data (after basis calculation). Skipping.")
        continue

    yrs = analog_years(region)
    if not yrs:
        print(f"No valid analog years found for region '{region}' (component '{comp_key_stripped}'). Skipping.")
        continue

    for y in yrs:
        # Determine the exact analog date (first early-June date of that year from EIA totals).
        analog_date_candidates = eia_totals[
            (eia_totals["Period"].dt.year == y) &
            (eia_totals["Period"].dt.isocalendar().week == EARLY_JUNE_ISO_WEEK)
        ]["Period"].sort_values()

        if analog_date_candidates.empty:
            print(f"Warning: No specific early-June date found in EIAtotals for year {y}. Skipping analog year.")
            continue

        analog_date = analog_date_candidates.iloc[0]

        # Get the base price (basis) for the component on the analog date.
        closest_base_market_date = nearest_date(basis.index, analog_date)
        base_price = basis.loc[closest_base_market_date, comp_key_stripped]

        # Check for NaNs immediately after fetching prices
        if pd.isna(base_price):
            print(f"Info: Base price is NaN for '{comp_key_stripped}' on {closest_base_market_date.date()} (closest to {analog_date.date()}). Skipping analog year {y}.")
            continue

        # Calculate price moves for each specified 'weeks ahead' period.
        for wk in WEEKS_AHEAD:
            future_date_target = analog_date + timedelta(weeks=wk)
            closest_future_market_date = nearest_date(basis.index, future_date_target)
            fut_price = basis.loc[closest_future_market_date, comp_key_stripped]

            # Skip if future price is NaN or if the price hasn't changed (0 move)
            if pd.isna(fut_price) or fut_price == base_price:
                continue

            # Calculate percentage change, handling division by zero
            pct_change_val = (fut_price - base_price) / base_price * 100 if base_price != 0 else np.nan

            # Append the calculated record to the list.
            records.append({
                "Region": region,
                "Component": comp_key_stripped,
                "AnalogYear": y,
                "WeeksAhead": wk,
                "ΔBasis ($)": fut_price - base_price, # Absolute change.
                "ΔBasis (%)": pct_change_val # Percentage change.
            })

# Create a DataFrame from the collected records.
df = pd.DataFrame(records)

# --- AGGREGATE PER-COMPONENT DATA ---
if not df.empty:
    # Group by Region, Component, and WeeksAhead to aggregate analog years.
    summary = (
        df.groupby(["Region", "Component", "WeeksAhead"])
        .agg(
            AnalogYear=('AnalogYear', lambda x: ",".join(map(str, sorted(set(x))))),
            Mean_Delta_Basis_Dollars=('ΔBasis ($)', 'mean'),
            Mean_Delta_Basis_Percent=('ΔBasis (%)', 'mean')
        )
        .reset_index()
    )

    # Pivot the table to have 'WeeksAhead' as columns for both absolute and percentage changes.
    summary_pivoted = summary.pivot_table(
        index=["Region", "Component", "AnalogYear"],
        columns="WeeksAhead",
        values=["Mean_Delta_Basis_Dollars", "Mean_Delta_Basis_Percent"]
    )

    # Flatten MultiIndex columns to a single level for easier readability.
    summary_pivoted.columns = [
        f"{col[0].replace('Mean_Delta_Basis_Dollars', 'ΔBasis ($)').replace('Mean_Delta_Basis_Percent', 'ΔBasis (%)')}_+{col[1]}wk"
        for col in summary_pivoted.columns
    ]
    summary = summary_pivoted.reset_index() # Reset index again after pivoting.

    # --- OUTPUT ---
    # Define the output file path in the same directory as the script.
    outfile = script_dir / "AnalogBasisReaction.csv"
    # Save the summary DataFrame to a CSV file.
    summary.to_csv(outfile, index=False)

    # Print confirmation message and the first few rows of the summary table.
    print("Analog basis reaction table saved to", outfile)
    print("\nFirst 20 rows of the Analog Basis Reaction Table:")
    print(summary.head(20))

    # --- ADD REGION-LEVEL AGGREGATE ---
    # Only calculate if df is not empty
    region_summary = (
        df.groupby(["Region", "WeeksAhead"])
        .agg(
            Count=('ΔBasis ($)', 'count'), # Count of individual data points contributing to the mean
            Avg_Delta_Basis_Dollars=('ΔBasis ($)', 'mean'),
            Avg_Delta_Basis_Percent=('ΔBasis (%)', 'mean')
        )
        .reset_index()
        .pivot(index="Region", columns="WeeksAhead")
    )

    # Flatten MultiIndex columns
    new_cols = []
    for stat, wk in region_summary.columns:
        stat_name = ""
        if stat == 'Count':
            stat_name = 'Count'
        elif stat == 'Avg_Delta_Basis_Dollars':
            stat_name = 'Avg_ΔBasis ($)'
        elif stat == 'Avg_Delta_Basis_Percent':
            stat_name = 'Avg_ΔBasis (%)'
        new_cols.append(f"{stat_name}_+{wk}wk")

    region_summary.columns = new_cols
    region_summary = region_summary.reset_index()

    # Print it
    print("\n=== Region-Level ΔBasis Summary ===")
    print(region_summary)

else:
    print("No data records were generated. Check inputs and data quality or adjust TOLERANCE_BCF and FFILL_LIMIT_DAYS.")
    print("No AnalogBasisReaction.csv was saved.")
    print("No Region-Level ΔBasis Summary was generated.")