    _k("TGP-500L"):         "South Central",
    _k("TGP-800L"):         "South Central",
    _k("TGP-Z0 South"):     "South Central",
    _k("TGP-Z1 100L"):      "South Central",
    _k("TGP-Z1 Sta-87"):    "South Central",
    _k("TGT-Mainline"):     "South Central",
    _k("Transco Zn3"):      "South Central",
