#!/usr/bin/env python3
"""
analog_basis_reaction.py

Goal
----
For each pipeline component and its EIA region:
1. Take 'current' early‑June storage (latest Period in EIAtotals.csv).
2. Find past years whose early‑June storage is within ±tolerance_bcf.
3. Compute basis (component − Henry Hub) move +N weeks later.
4. Aggregate analog years → mean $/MMBtu and % change.

Outputs
-------
- Prints summary dataframe.
- Saves AnalogBasisReaction.csv in script directory.
- Prints a region-level aggregate summary.

Inputs
------
INFO/EIAtotals.csv      : region storage levels
INFO/PRICES.csv         : daily spot prices by component
"""
import pandas as pd
import numpy as np
from pathlib import Path
from datetime import timedelta

# ---------- USER SETTINGS ----------
TOLERANCE_BCF = 40          # ± Bcf window for storage analogs (Increased to 40)
WEEKS_AHEAD   = [2, 3, 4]   # Weeks after analog date to measure price move
EARLY_JUNE_ISO_WEEK = 23    # ISO week number for "early June"
HENRY_COL = "Henry"         # Column name of Henry Hub in PRICES.csv (Confirmed from your CSV)
FFILL_LIMIT_DAYS = 7        # Max days to forward/backward fill for prices (Increased to 7)
# -----------------------------------

# ---- EIA regions available in EIAtotals.csv -----------------
REGION_INFO = {
    "East":          "East Region Storage (Bcf)",
    "Midwest":       "Midwest Region Storage (Bcf)",
    "Mountain":      "Mountain Region Storage (Bcf)",
    "Pacific":       "Pacific Region Storage (Bcf)",
    "South Central": "South Central Region Storage (Bcf)",
    # -- OPTIONAL catch‑all —
    # "Lower 48":   "Total Lower 48 Storage (Bcf)",
}

# ----- HARD‑CODED COMPONENT→REGION MAP -----
# This map links each pipeline component to its corresponding EIA region.
# It is essential for comparing component prices with regional storage levels.
