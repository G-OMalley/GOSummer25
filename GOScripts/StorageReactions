    _k("TGP-Z4 Sta-219"):        "East",
    _k("TGP-Z4 Sta-313"):        "East",
    _k("Transco-Z6 (NY)"):               "East",
    _k("Transco-Z6 (non-NY north)"):     "East",
    _k("Transco-Z6 (non-NY)"):           "East",
    _k("Transco-Z6 Sta-210"):            "East",

    # ------------- Midwest (10) ----------
    _k("Chicago"):              "Midwest",
    _k("Michcon"):              "Midwest",
